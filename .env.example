# =============================================================================
# CodeGuard AI — environment template
# =============================================================================
# Copy to .env and fill in. `.env` is git-ignored and MUST NEVER be committed.
#
# No real secret belongs in this file. Every value here is either a safe
# development default or an empty placeholder.
# =============================================================================

# -- Application --------------------------------------------------------------
APP_ENV=development          # development | test | staging | production
DEBUG=true                   # must be false outside development
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR | CRITICAL

# -- HTTP ---------------------------------------------------------------------
# Exactly one browser origin. This becomes the CORS allow-list.
# Must be https outside development.
FRONTEND_URL=http://localhost:5173

# This API's own externally-visible origin. The OAuth redirect URI is built
# from it, NEVER from the inbound request — a redirect URI derived from a Host
# header can be steered elsewhere by forging that header.
# Required outside development; must be https there.
PUBLIC_BASE_URL=http://localhost:8000

# Comma-separated Host values this deployment answers to.
# `*` is REFUSED outside development: a wildcard serves any Host header, which
# enables cache poisoning and forged absolute links.
TRUSTED_HOSTS=*

# How many reverse proxies sit in front of this process.
# 0 ignores X-Forwarded-* entirely, which is correct when nothing is in front
# and is the safe default — any client can send those headers. Behind one load
# balancer set 1; only the last hop's value is trusted.
TRUSTED_PROXY_COUNT=0

# -- Database -----------------------------------------------------------------
# Must use the asyncpg driver; a plain postgresql:// URL is rejected at startup.
DATABASE_URL=postgresql+asyncpg://codeguard:codeguard@localhost:5432/codeguard

# -- GitHub App ---------------------------------------------------------------
# Required for live GitHub integration. Without them the app still starts and
# /health reports github_app_configured=false; webhook deliveries are rejected
# (an unconfigured receiver must never accept everything).
#
# GITHUB_PRIVATE_KEY accepts three encodings, detected by content:
#   1. a real multi-line PEM        (.env files, Docker secrets)
#   2. one line with literal \n     (what most dashboards and CI stores produce)
#   3. base64 of the whole PEM      (recommended for staging and production)
GITHUB_APP_ID=
GITHUB_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# -- Background queue / worker ------------------------------------------------
WORKER_POLL_INTERVAL_SECONDS=2
JOB_VISIBILITY_TIMEOUT_SECONDS=900   # before a crashed worker's job is reclaimed
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_SECONDS=30
JOB_BACKOFF_CAP_SECONDS=900
JOB_SWEEP_INTERVAL_SECONDS=60

# -- GitHub ingest tuning -----------------------------------------------------
# Applied to `synchronize` only, so a burst of pushes produces one sync.
SYNCHRONIZE_DEBOUNCE_SECONDS=20
GITHUB_MAX_FILES_PER_PR=3000
GITHUB_REQUEST_TIMEOUT_SECONDS=20
GITHUB_MAX_RETRIES=3

# -- AI provider --------------------------------------------------------------
# The application talks to an AIReviewProvider, never to a vendor directly.
# Switching provider is a change to this line and nothing else.
AI_PROVIDER=gemini           # gemini | claude

# Gemini — the initial provider. Leave empty in Phase 0; no call is made.
# GEMINI_MODEL has no default on purpose: the supported model is chosen
# against Google's current documentation during the AI integration phase.
GEMINI_API_KEY=
GEMINI_MODEL=

# Claude — optional future provider. Not required when AI_PROVIDER=gemini.
CLAUDE_API_KEY=
CLAUDE_MODEL=

# =============================================================================
# NEVER COMMIT: GEMINI_API_KEY, CLAUDE_API_KEY, GITHUB_PRIVATE_KEY,
#               GITHUB_WEBHOOK_SECRET, GitHub access tokens, DATABASE_URL
#               containing a real password.
# No AI API key is ever exposed to the frontend. All AI calls are server-side.
# =============================================================================

# -- Authentication (Phase 5) --------------------------------------------------
# The GitHub App's OAuth credentials. DISTINCT from GITHUB_APP_ID /
# GITHUB_PRIVATE_KEY above: those authenticate the App to act on repositories
# and say nothing about who is holding the browser.
#
# Find them on the App's settings page. The callback URL registered there must
# be exactly:  <PUBLIC_BASE_URL>/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# HMAC key for session signing and CSRF derivation.
#
# Generate with:  openssl rand -base64 48
#
# PRODUCTION WILL NOT START WITHOUT IT, and there is deliberately no fallback
# constant: a fallback secret is a secret an attacker also has. Leave it empty
# in development and the process generates a random key per run, so forgetting
# it costs one re-login and can never be mistaken for a configured deployment.
# Rotating it invalidates every session, which is the intended effect.
SESSION_SECRET=

# Session lifetimes, in seconds.
SESSION_TTL_SECONDS=28800            # absolute; never extended by activity
SESSION_IDLE_TIMEOUT_SECONDS=7200    # separate from the absolute expiry

# Cookie attributes. Leave SESSION_COOKIE_SECURE unset to decide from the
# environment (Secure everywhere except development, where localhost has no
# TLS and a Secure cookie would simply never be stored).
SESSION_COOKIE_NAME=codeguard_session
SESSION_COOKIE_DOMAIN=
SESSION_COOKIE_SECURE=
# `lax` is required, not merely convenient: `strict` withholds the cookie on
# the cross-site navigation back from github.com and the OAuth flow fails
# every time. `lax` is not by itself CSRF protection — see app/api/authn.py.
SESSION_COOKIE_SAMESITE=lax

OAUTH_STATE_TTL_SECONDS=600

# -- Rate limiting -------------------------------------------------------------
# In-process, per-process, approximate. With N API processes the effective
# limit is N times these values, and a restart forgets every counter. Stated
# here rather than discovered later: it bounds a runaway client, it is not a
# precise global quota. See app/core/ratelimit.py.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=120
RATE_LIMIT_WEBHOOK_PER_MINUTE=600

# -- Resource ceilings ----------------------------------------------------------
MAX_REQUEST_BODY_BYTES=1048576        # 1 MiB; enforced before buffering
GITHUB_MAX_RESPONSE_BYTES=41943040    # 40 MiB; enforced while streaming

# -- Worker shutdown ------------------------------------------------------------
# How long a worker may spend finishing its in-flight job after SIGTERM.
# MUST be smaller than the orchestrator's stop grace period, or the process is
# killed while it is still draining and nothing is gained.
WORKER_SHUTDOWN_DRAIN_SECONDS=120

# Multiple of JOB_VISIBILITY_TIMEOUT_SECONDS after which a `running` review run
# is treated as abandoned and closed by the sweep.
REVIEW_RUN_ABANDON_TIMEOUT_MULTIPLIER=3

# -- Dashboard -----------------------------------------------------------------
# Serve the dashboard API with NO authentication at all.
#
# Phase 4 needed this because there was no way to sign in. Phase 5 ships GitHub
# OAuth, so there is no longer a reason for it, and PRODUCTION REFUSES TO START
# when it is true. Setting it means exposing every monitored repository's
# review data to anyone who can reach the port.
DASHBOARD_ALLOW_UNAUTHENTICATED_READS=false
DASHBOARD_MAX_PAGE_SIZE=100
