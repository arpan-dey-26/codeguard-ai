# Frontend environment (Vite).
#
# SECURITY: only variables prefixed with VITE_ are exposed to the browser, and
# everything exposed to the browser is public. No API key of any kind —
# Gemini, Claude, GitHub — may ever appear in this file or in any VITE_
# variable. All AI calls are made server-side by the backend.

# Base URL of the CodeGuard AI backend.
# Leave empty in development to use the Vite dev-server proxy.
VITE_API_BASE_URL=
